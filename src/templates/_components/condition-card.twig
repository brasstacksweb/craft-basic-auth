{# @var id string #}
{# @var key string #}
{# @var condition \brasstacksweb\craftbasicauth\models\Condition #}

{% set title = condition.realm ?: 'New Condition' %}

<div class="pane" data-condition="{{ title|kebab }}-{{ id }}">
	<div class="field" style="margin:0">
		<div class="flex">
			<h2 class="flex-grow" style="margin:0">
				<span class="status {{ condition.enabled ? 'enabled' : 'disabled' }}"></span>
				<span>{{ title }}</span>
			</h2>
			<nav>
				<button type="button" class="btn small">Collapse</button>
				<button type="button" class="btn small delete">Delete</button>
			</nav>
		</div>
	</div>

	<div style="margin-top:24px;" data-condition-content>
		{% include 'craft-basic-auth/_components/condition-fields.twig' with {
			id: id,
			key: key,
			condition: condition,
		} %}
	</div>

	<script>
		(function (condition) {
			const [toggleBtn, deleteBtn] = condition.querySelectorAll('nav > button');

			toggleBtn.onclick = ({ currentTarget }) => {
				const content = condition.querySelector('[data-condition-content]');

				content.style.display = content.style.display === 'none' ? 'block' : 'none';
				currentTarget.textContent = content.style.display === 'none' ? 'Expand' : 'Collapse';
			};
			deleteBtn.onclick = () => {
				if (confirm('Are you sure you want to delete this condition?')) {
					condition.remove();
				}
			};
		})(document.querySelector('[data-condition={{ title|kebab }}-{{ id }}]'));
	</script>
</div>
