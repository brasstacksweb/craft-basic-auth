{# @var id string #}
{# @var key string #}
{# @var condition \brasstacksweb\craftbasicauth\models\Condition #}

{% set id = id ?? key %}

{% import '_includes/forms' as forms %}

<div>
	{{ forms.lightswitchField({
		label: condition.getAttributeLabel('enabled'),
		name: key ~ '[enabled]',
		on: condition.enabled,
		toggle: 'condition-content-' ~ key,
	}) }}

	{{ forms.textField({
		label: condition.getAttributeLabel('realm'),
		instructions: condition.getAttributeHint('realm'),
		id: id ~ '-realm',
		name: key ~ '[realm]',
		value: condition.realm,
		placeholder: condition.getAttributePlaceholder('realm'),
		errors: condition.getErrors('realm'),
		required: true,
	}) }}

	<div class="field">
		<div class="heading">
			<label class="required">Trigger Conditions</label>
			<div class="instructions">
				<p>Authentication will be required when <strong>any</strong> of these conditions match.</p>
			</div>
		</div>

		{{ forms.editableTableField({
			label: condition.getAttributeLabel('environments'),
			instructions: condition.getAttributeHint('environments'),
			id: id ~ '-environments',
			name: key ~ '[environments]',
			cols: [
				{
					type: 'singleline',
					heading: 'Environment',
					placeholder: condition.getAttributePlaceholder('environments'),
				}
			],
			rows: condition.environments|map(e => [e]),
			errors: condition.getErrors('environments'),
			allowAdd: true,
			allowDelete: true,
			addRowLabel: 'Add an Environment',
		}) }}

		{{ forms.editableTableField({
			label: condition.getAttributeLabel('domains'),
			instructions: condition.getAttributeHint('domains'),
			id: id ~ '-domains',
			name: key ~ '[domains]',
			cols: [
				{
					type: 'singleline',
					heading: 'Domain',
					placeholder: condition.getAttributePlaceholder('domains'),
				}
			],
			rows: condition.domains|map(d => [d]),
			errors: condition.getErrors('domains'),
			allowAdd: true,
			allowDelete: true,
			addRowLabel: 'Add an Environment',
		}) }}
	</div>

	<div class="field">
		<div class="heading">
			<h3>Credentials</h3>
		</div>

		{{ forms.textField({
			label: condition.getAttributeLabel('username'),
			id: id ~ '-username',
			name: key ~ '[username]',
			value: condition.username,
			placeholder: condition.getAttributePlaceholder('username'),
			errors: condition.getErrors('username'),
			required: true,
		}) }}

		{{ forms.autosuggestField({
			label: condition.getAttributeLabel('password'),
			id: id ~ '-password',
			name: key ~ '[password]',
			suggestEnvVars: true,
			value: condition.password,
			placeholder: condition.getAttributePlaceholder('password'),
			errors: condition.getErrors('password'),
			required: true,
		}) }}
	</div>

	<div class="field">
		<div class="heading">
			<h3>Bypass Settings</h3>
		</div>

		{{ forms.editableTableField({
			label: condition.getAttributeLabel('exceptedPaths'),
			instructions: condition.getAttributeHint('exceptedPaths'),
			id: id ~ '-exceptedPaths',
			name: key ~ '[exceptedPaths]',
			cols: [
				{
					type: 'singleline',
					heading: 'Path',
					placeholder: condition.getAttributePlaceholder('exceptedPaths'),
				}
			],
			rows: condition.exceptedPaths|map(p => [p]),
			errors: condition.getErrors('exceptedPaths'),
			allowAdd: true,
			allowDelete: true,
			addRowLabel: 'Add an Path',
		}) }}

		{{ forms.editableTableField({
			label: condition.getAttributeLabel('protectedPaths'),
			instructions: condition.getAttributeHint('protectedPaths'),
			id: id ~ '-protectedPaths',
			name: key ~ '[protectedPaths]',
			cols: [
				{
					type: 'singleline',
					heading: 'Path',
					placeholder: condition.getAttributePlaceholder('protectedPaths'),
				}
			],
			rows: condition.protectedPaths|map(p => [p]),
			errors: condition.getErrors('protectedPaths'),
			allowAdd: true,
			allowDelete: true,
			addRowLabel: 'Add an Path',
		}) }}

		{{ forms.textField({
			label: condition.getAttributeLabel('customFailureMessage'),
			instructions: condition.getAttributeHint('customFailureMessage'),
			id: id ~ '-customFailureMessage',
			name: key ~ '[customFailureMessage]',
			value: condition.customFailureMessage,
			placeholder: condition.getAttributePlaceholder('customFailureMessage'),
			errors: condition.getErrors('customFailureMessage'),
		}) }}
	</div>
</div>
