{# @var settings \brasstacksweb\craftbasicauth\models\Settings #}

{% import "_includes/forms" as forms %}

{% block content %}
    {{ actionInput("craft-basic-auth/settings/save") }}
    {{ redirectInput("settings/plugins/craft-basic-auth") }}

    <div class="field">
        <div class="heading">
            <h2>Authentication Rules</h2>
            <div class="instructions">
                <p>Configure HTTP Basic Authentication rules below. Rules can be triggered by environment, domain patterns, or Craft sites.</p>
            </div>
        </div>
        
        <div class="readable">
            <div class="field">
                <div class="heading">
                    <h3>Current Context</h3>
                </div>
                <div class="input ltr">
                    <span class="code">Environment: {{ craft.app.config.env }}</span>
                    <span class="code">Site: {{ currentSite.handle }}</span>
                    <span class="code">Domain: {{ craft.app.request.hostName }}</span>
                </div>
            </div>
        </div>
    </div>

    <div id="auth-rules">
        {% for key, rule in settings.authRules %}
            {{ _self.renderRuleFields(key, rule) }}
        {% endfor %}
        
        <div class="buttons">
            <button type="button" class="btn add icon" id="add-rule-btn">Add New Rule</button>
        </div>
    </div>

    <template id="rule-template">
        {{ _self.renderRuleFields('__RULE_KEY__', create('brasstacksweb\\craftbasicauth\\models\\Condition')) }}
    </template>
{% endblock %}

{% macro renderRuleFields(key, rule) %}
    <div class="rule-item pane" data-key="{{ key }}">
        <div class="rule-header field">
            <div class="flex">
                <h2 class="flex-grow">
                    <span class="status {{ rule.enabled ? 'enabled' : 'disabled' }}"></span>
                    <span class="rule-title">{{ rule.realm ?: 'New Authentication Rule' }}</span>
                </h2>
                <div>
                    <button type="button" class="btn small rule-toggle">{{ rule.enabled ? 'Collapse' : 'Expand' }}</button>
                    <button type="button" class="btn small delete rule-delete">Delete</button>
                </div>
            </div>
        </div>
        
        <div class="rule-content" style="{{ not rule.enabled ? 'display: none;' }}">
            <input type="hidden" name="authRules[{{ key }}][enabled]" value="{{ rule.enabled ? '1' : '0' }}">
            
            {{ forms.lightswitchField({
                label: 'Enable Basic Auth',
                name: 'authRules[' ~ key ~ '][enabled]',
                on: rule.enabled,
                toggle: 'rule-content-' ~ key
            }) }}
            
            {{ forms.textField({
                label: 'Realm Name',
                instructions: 'Unique identifier and HTTP Basic Auth realm',
                id: 'authRules-' ~ key ~ '-realm',
                name: 'authRules[' ~ key ~ '][realm]',
                value: rule.realm,
                placeholder: 'e.g., Development Environment, Staging Sites',
                required: true
            }) }}
            
            <div class="field">
                <div class="heading">
                    <label class="required">Trigger Conditions</label>
                    <div class="instructions">
                        <p>Authentication will be required when <strong>any</strong> of these conditions match.</p>
                    </div>
                </div>
                
                {{ forms.autosuggestField({
                    label: 'Environments',
                    instructions: 'Case-insensitive environment names',
                    id: 'authRules-' ~ key ~ '-environments',
                    name: 'authRules[' ~ key ~ '][environments]',
                    suggestEnvVars: false,
                    suggestions: ['dev', 'staging', 'production', 'local', 'development'],
                    value: rule.environments,
                    placeholder: 'e.g., dev, staging, production'
                }) }}
                
                {{ forms.autosuggestField({
                    label: 'Domains',
                    instructions: 'Domain patterns with wildcard support',
                    id: 'authRules-' ~ key ~ '-domains',
                    name: 'authRules[' ~ key ~ '][domains]',
                    suggestEnvVars: false,
                    value: rule.domains,
                    placeholder: 'e.g., *.dev.local, staging.example.com'
                }) }}
                
                {{ forms.checkboxSelectField({
                    label: 'Sites',
                    instructions: 'Craft site handles',
                    id: 'authRules-' ~ key ~ '-sites',
                    name: 'authRules[' ~ key ~ '][sites]',
                    options: craft.app.sites.getAllSites()|map(site => {
                        label: site.name,
                        value: site.handle
                    }),
                    values: rule.sites
                }) }}
            </div>
            
            <div class="field">
                <div class="heading">
                    <label class="required">Credentials</label>
                </div>
                
                {{ forms.textField({
                    label: 'Username',
                    id: 'authRules-' ~ key ~ '-username',
                    name: 'authRules[' ~ key ~ '][username]',
                    value: rule.username,
                    placeholder: 'e.g., dev, staging',
                    required: true
                }) }}
                
                {{ forms.autosuggestField({
                    label: 'Password',
                    id: 'authRules-' ~ key ~ '-password',
                    name: 'authRules[' ~ key ~ '][password]',
                    suggestEnvVars: true,
                    value: rule.password,
                    placeholder: 'Password or $ENV_VARIABLE',
                    required: true
                }) }}
            </div>
            
            <div class="field">
                <div class="heading">
                    <label>Bypass Settings</label>
                </div>
                
                {{ forms.autosuggestField({
                    label: 'IP Whitelist',
                    instructions: 'IP addresses/patterns that bypass auth',
                    id: 'authRules-' ~ key ~ '-ipWhitelist',
                    name: 'authRules[' ~ key ~ '][ipWhitelist]',
                    suggestEnvVars: false,
                    value: rule.ipWhitelist,
                    placeholder: 'e.g., 127.0.0.1, 192.168.1.*, 10.0.0.0/8'
                }) }}
                
                {{ forms.autosuggestField({
                    label: 'User-Agent Exceptions',
                    instructions: 'User-Agent patterns that bypass auth',
                    id: 'authRules-' ~ key ~ '-userAgentExceptions',
                    name: 'authRules[' ~ key ~ '][userAgentExceptions]',
                    suggestEnvVars: false,
                    value: rule.userAgentExceptions,
                    placeholder: 'e.g., *bot*, *crawler*, *monitor*'
                }) }}
                
                {{ forms.autosuggestField({
                    label: 'Excepted Paths',
                    instructions: 'URI patterns that bypass auth',
                    id: 'authRules-' ~ key ~ '-exceptedPaths',
                    name: 'authRules[' ~ key ~ '][exceptedPaths]',
                    suggestEnvVars: false,
                    value: rule.exceptedPaths,
                    placeholder: 'e.g., /webhooks/*, /api/health, /system/status'
                }) }}
                
                {{ forms.autosuggestField({
                    label: 'Protected Paths',
                    instructions: 'URI patterns that require auth even if environment/domain not protected',
                    id: 'authRules-' ~ key ~ '-protectedPaths',
                    name: 'authRules[' ~ key ~ '][protectedPaths]',
                    suggestEnvVars: false,
                    value: rule.protectedPaths,
                    placeholder: 'e.g., /admin/reports/*'
                }) }}
                
                {{ forms.textField({
                    label: 'Custom Failure Message',
                    instructions: 'Optional custom 401 message',
                    id: 'authRules-' ~ key ~ '-customFailureMessage',
                    name: 'authRules[' ~ key ~ '][customFailureMessage]',
                    value: rule.customFailureMessage,
                    placeholder: 'e.g., Development access required'
                }) }}
                
                {{ forms.lightswitchField({
                    label: 'Bypass for Logged-in Users',
                    instructions: 'Skip authentication for users already logged in to Craft CMS',
                    id: 'authRules-' ~ key ~ '-bypassForLoggedInUsers',
                    name: 'authRules[' ~ key ~ '][bypassForLoggedInUsers]',
                    on: rule.bypassForLoggedInUsers
                }) }}
            </div>
        </div>
    </div>
{% endmacro %}

{% js %}
    document.addEventListener('DOMContentLoaded', function() {
        // Generate unique keys for new rules
        function generateKey() {
            return 'rule-' + Math.random().toString(36).substring(2, 15);
        }
        
        // Add new rule button
        document.getElementById('add-rule-btn').addEventListener('click', function() {
            const template = document.getElementById('rule-template').innerHTML;
            const newKey = generateKey();
            const newRule = template.replace(/__RULE_KEY__/g, newKey);
            
            const container = document.getElementById('auth-rules');
            const btnContainer = this.parentNode;
            
            // Insert before button container
            btnContainer.insertAdjacentHTML('beforebegin', newRule);
            
            // Initialize Craft UI elements
            Craft.initUiElements();
            
            // Setup event handlers for the new rule
            setupRuleEventHandlers(newKey);
        });
        
        // Setup event handlers for rule toggle and delete
        function setupRuleEventHandlers(key) {
            const ruleItem = document.querySelector('.rule-item[data-key="' + key + '"]');
            
            if (!ruleItem) return;
            
            // Toggle rule visibility
            const toggleBtn = ruleItem.querySelector('.rule-toggle');
            toggleBtn.addEventListener('click', function() {
                const content = ruleItem.querySelector('.rule-content');
                content.style.display = content.style.display === 'none' ? 'block' : 'none';
                this.textContent = content.style.display === 'none' ? 'Expand' : 'Collapse';
            });
            
            // Delete rule
            const deleteBtn = ruleItem.querySelector('.rule-delete');
            deleteBtn.addEventListener('click', function() {
                if (confirm('Are you sure you want to delete this rule?')) {
                    ruleItem.remove();
                }
            });
            
            // Update rule title when realm changes
            const realmInput = ruleItem.querySelector('[id$="-realm"]');
            realmInput.addEventListener('input', function() {
                const titleEl = ruleItem.querySelector('.rule-title');
                titleEl.textContent = this.value || 'New Authentication Rule';
            });
        }
        
        // Setup existing rules
        document.querySelectorAll('.rule-item').forEach(function(ruleItem) {
            const key = ruleItem.getAttribute('data-key');
            setupRuleEventHandlers(key);
        });
    });
{% endjs %}

{% css %}
    .rule-item {
        margin-bottom: 20px;
    }
    
    .rule-header {
        margin-bottom: 10px;
    }
    
    .rule-title {
        font-weight: bold;
    }
    
    .rule-content {
        padding: 10px;
    }
{% endcss %}