{# @var settings \brasstacksweb\craftbasicauth\models\Settings #}

{% do view.registerAssetBundle('brasstacksweb\\craftbasicauth\\assetbundles\\SettingsAsset') %}

{% block content %}
	<div class="flex flex-justify-end">
		<a href="{{ url('craft-basic-auth/conditions') }}" class="btn add icon" data-add-condition>Add New Condition</a>
	</div>
	<div class="field">
		<div class="heading">
			<h2>Authentication Conditions</h2>
			<div class="instructions">
				<p>Configure HTTP Basic Authentication conditions below. Conditions can be triggered by environment or domain patterns</p>
			</div>
		</div>
	</div>
	{# Needed to submit with after deleting last condition #}
	<input type="hidden" name="conditions" value="">
	{% for key, condition in settings.conditions %}
		{% include 'craft-basic-auth/_components/condition-card.twig' with {
			id: 'condition-' ~ key,
			key: 'conditions[' ~ key ~ ']',
			condition: condition,
		} %}
	{% endfor %}
{% endblock %}
